From e4af907b74b7c0bd916133d4e60e2d9c2fd70569 Mon Sep 17 00:00:00 2001
From: ereaxff-build <build@localhost>
Date: Wed, 11 Nov 2026 02:57:53 -0500
Subject: [PATCH 5/9] tests: MTS [1,4] conservation (NVE and NVT, both
 splittings) with classical atoms

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 ipi_tests/classical_atoms/test_classical_atoms.py | 13 +++++++++++--
 1 file changed, 11 insertions(+), 2 deletions(-)

diff --git a/ipi_tests/classical_atoms/test_classical_atoms.py b/ipi_tests/classical_atoms/test_classical_atoms.py
index ff8025e..35d4ada 100644
--- a/ipi_tests/classical_atoms/test_classical_atoms.py
+++ b/ipi_tests/classical_atoms/test_classical_atoms.py
@@ -98,7 +98,7 @@ def launch(workdir, root, driver_root, input_name="input.xml", address=None, dri
 def run_ipi(workdir, root=None, driver_root=None, nbeads=8, steps=20000, dt=8.0, tau=400.0, thermo="pile_l",
             classical="[0]", velocities=None, mode="nvt", stride=10, seed=12345, extra_thermo="",
             splitting="obabo", dyn_extra="", out_extra="", sys_extra="", forces=None, nm_extra="",
-            driver="coupled_harmonic", driver_opts=None, init_xyz=None, timeout=1800, ffs=None, extra_drivers=()):
+            driver="coupled_harmonic", driver_opts=None, init_xyz=None, timeout=1800, ffs=None, extra_drivers=(), address=None):
     root = Path(root) if root else ROOT
     driver_root = Path(driver_root) if driver_root else root
     workdir = Path(workdir)
@@ -106,7 +106,7 @@ def run_ipi(workdir, root=None, driver_root=None, nbeads=8, steps=20000, dt=8.0,
     (workdir / "init.xyz").write_text(init_xyz or (
         "2\n# CELL(abcABC): 200 200 200 90 90 90 positions{atomic_unit} cell{atomic_unit}\n"
         "C 0.5 0.0 0.0\nH 1.0 0.5 0.0\n"))
-    address = "cl%d" % (os.getpid() % 100000)
+    address = address or "cl%d" % (os.getpid() % 100000)
     cl = "<classical_atoms> %s </classical_atoms>" % classical if classical else ""
     if velocities is None:
         vel = "<velocities mode='thermal' units='kelvin'> %g </velocities>" % TEMP
@@ -353,3 +353,12 @@ def test_mts_nve_conservation(tmp_path, splitting):
     span, drift = _conserved_drift(read_out(tmp_path / "sim.out"))
     print("MTS [1,4] %s NVE conserved span / kT = %.3g, linear drift / kT = %.3g" % (splitting, span, drift))
     assert span < 5e-2 and abs(drift) < 1e-2
+
+
+@pytest.mark.parametrize("splitting", ["obabo", "baoab"])
+def test_mts_nvt_conservation(tmp_path, splitting):
+    """MTS with a thermostat: the energy removed from the classical atom's internal modes must stay booked."""
+    _mts_run(tmp_path, "[1, 4]", splitting=splitting, mode="nvt", thermo="pile_l", tau=200.0)
+    span, drift = _conserved_drift(read_out(tmp_path / "sim.out"))
+    print("MTS [1,4] %s NVT conserved span / kT = %.3g, linear drift / kT = %.3g" % (splitting, span, drift))
+    assert span < 5e-2 and abs(drift) < 1e-2
