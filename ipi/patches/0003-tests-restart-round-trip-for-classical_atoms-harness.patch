+def launch(workdir, root, driver_root, input_name="input.xml", address=None, driver="coupled_harmonic",
+           driver_opts=None, timeout=1800):
+    """Starts i-PI on `input_name` plus a Python driver client, waits for i-PI to exit."""
+    workdir = Path(workdir)
+    if address is None:  # a restart file remembers the socket address of the run that wrote it
+        import re
+        m = re.search(r"<address>\s*([^<\s]+)\s*</address>", (workdir / input_name).read_text())
+        address = m.group(1) if m else "cl%d" % (os.getpid() % 100000)
+    driver_opts = driver_opts if driver_opts is not None else "%g,%g" % (K_TRAP, K_SPR)
+    env = dict(os.environ, PYTHONPATH=str(root), PYTHONUNBUFFERED="1", OMP_NUM_THREADS="1",
+               OPENBLAS_NUM_THREADS="1", VECLIB_MAXIMUM_THREADS="1")
+    log = workdir / ("ipi_%s.log" % Path(input_name).stem)
+    srv = subprocess.Popen([sys.executable, str(root / "bin" / "i-pi"), input_name], cwd=workdir,
+                           env=env, stdout=open(log, "w"), stderr=subprocess.STDOUT)
+    time.sleep(3)
+    drv = subprocess.Popen(
+        [sys.executable, str(driver_root / "bin" / "i-pi-py_driver"), "-m", driver, "-u",
+         "-a", address, "-o", driver_opts],
+        cwd=workdir, env=dict(env, PYTHONPATH=str(driver_root)), stdout=open(workdir / "drv.log", "w"),
+        stderr=subprocess.STDOUT)
+    try:
+        srv.wait(timeout=timeout)
+    finally:
+        drv.terminate()
+        if srv.poll() is None:
+            srv.kill()
+    assert srv.returncode == 0, "i-PI failed:\n" + log.read_text()[-3000:]
+    return workdir
+
