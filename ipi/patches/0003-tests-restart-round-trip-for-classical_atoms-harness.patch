+def test_restart_roundtrip(tmp_path):
+    """<classical_atoms> is written to the checkpoint, and a restarted run continues exactly
+    like an uninterrupted one (positions, energies, RNG state)."""
+    kw = dict(nbeads=4, dt=8.0, mode="nvt", stride=1, seed=5)
+    run_ipi(tmp_path / "full", steps=200, **kw)
+    half = tmp_path / "half"
+    run_ipi(half, steps=100, out_extra="<checkpoint filename='chk' stride='100' overwrite='True'/>", **kw)
+    chk = (half / "sim.chk").read_text()
+    assert "<classical_atoms shape='(1)'> [ 0 ] </classical_atoms>" in chk
+    (half / "restart.xml").write_text(chk.replace("<total_steps>100</total_steps>", "<total_steps>200</total_steps>"))
+    launch(half, ROOT, ROOT, "restart.xml")
+    # The checkpoint stores floats with limited precision, so a restart reproduces an uninterrupted
+    # run only to ~5e-9 relative (unpatched i-PI shows the same, measured as a control).
+    a, b = read_out(tmp_path / "full" / "sim.out"), read_out(half / "sim.out")
+    assert a.shape == b.shape
+    rel = np.abs(a - b)[:, 1:] / np.maximum(np.abs(a[:, 1:]), 1e-30)
+    assert rel.max() < 1e-7, rel.max()
+    for bead in (0, 3):
+        fa = read_xyz_frames(tmp_path / "full" / ("sim.pos_%d.xyz" % bead), 2)
+        fb = read_xyz_frames(half / ("sim.pos_%d.xyz" % bead), 2)
+        assert np.max(np.abs(fa - fb)) < 2.5e-6  # output resolution is 1e-6
+    # the classical atom's beads are still identical after the restart
+    f0 = read_xyz_frames(half / "sim.pos_0.xyz", 2)[:, 0]
+    f3 = read_xyz_frames(half / "sim.pos_3.xyz", 2)[:, 0]
+    assert np.max(np.abs(f0 - f3)) < 1e-9
