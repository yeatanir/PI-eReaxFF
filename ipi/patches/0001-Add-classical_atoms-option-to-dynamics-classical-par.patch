diff --git a/ipi/pes/coupled_harmonic.py b/ipi/pes/coupled_harmonic.py
new file mode 100644
index 0000000..68d7755
--- /dev/null
+++ b/ipi/pes/coupled_harmonic.py
@@ -0,0 +1,49 @@
+"""Harmonic trap on atom 0, harmonic spring between atom 0 and atom 1.
+
+Test potential for simulations that mix a classical atom (atom 0) with a
+ring-polymer atom (atom 1):
+
+    V = 1/2 K |X|^2 + 1/2 k |x - X|^2
+
+Because V depends on x only through x - X, the ring-polymer part factorises
+from X, which gives exact references for a path-integral simulation at
+temperature T with P beads (a.u., hbar = 1, omega_P = P k_B T):
+
+    <X^2>              = k_B T / K                       per Cartesian component
+    <(x_j - X)^2>      = k_B T sum_{l=0}^{P-1} 1/(m w_l^2 + k)   (bead average)
+    <(x_c - X)^2>      = k_B T / k                       (centroid of the ring)
+"""
+
+from .dummy import Dummy_driver
+import numpy as np
+
+__DRIVER_NAME__ = "coupled_harmonic"
+__DRIVER_CLASS__ = "Coupled_harmonic_driver"
+
+
+class Coupled_harmonic_driver(Dummy_driver):
+    """
+    Command-line:
+        i-pi-py_driver -m coupled_harmonic -u -o 0.01,0.02
+
+    Init parameters:
+        :param K: float, trap constant acting on atom 0 (a.u.)
+        :param k: float, spring constant between atoms 0 and 1 (a.u.)
+    """
+
+    def __init__(self, K, k, *args, **kwargs):
+        self.K = float(K)
+        self.k = float(k)
+        super().__init__(*args, **kwargs)
+
+    def compute_structure(self, cell, pos):
+        p = pos.reshape(-1, 3)
+        if p.shape[0] != 2:
+            raise ValueError("coupled_harmonic needs exactly two atoms")
+        d = p[1] - p[0]
+        pot = 0.5 * self.K * np.dot(p[0], p[0]) + 0.5 * self.k * np.dot(d, d)
+        force = np.zeros_like(p)
+        force[0] = -self.K * p[0] + self.k * d
+        force[1] = -self.k * d
+        vir = cell * 0.0
+        return pot, force.reshape(pos.shape), vir, "nada"
diff --git a/ipi_tests/classical_atoms/test_classical_atoms.py b/ipi_tests/classical_atoms/test_classical_atoms.py
new file mode 100644
index 0000000..ab66e86
--- /dev/null
+++ b/ipi_tests/classical_atoms/test_classical_atoms.py
@@ -0,0 +1,199 @@
+"""Statistical tests for the `classical_atoms` option of <dynamics>.
+
+Runs i-PI (server) and the Python driver (client) as subprocesses on the
+coupled harmonic potential of ipi/pes/coupled_harmonic.py. Atom 0 is classical,
+atom 1 is a P-bead ring polymer. Atomic units, hbar = 1.
+
+Run with:  python -m pytest ipi_tests/classical_atoms -x -q -s
+"""
+
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+import time
+from pathlib import Path
+
+import numpy as np
+import pytest
+
+ROOT = Path(__file__).resolve().parents[2]
+KB = 3.166811563e-6  # Hartree / K
+M = 1837.36223469  # 1 amu in a.u.
+TEMP = 300.0
+K_TRAP = 0.0100  # trap on the classical atom
+K_SPR = 0.0200  # spring classical-quantum
+
+TEMPLATE = """<simulation verbosity='low'>
+  <output prefix='sim'>
+    <properties stride='{stride}' filename='out'> [ step, conserved, temperature{{kelvin}}, potential, kinetic_cv ] </properties>
+    <trajectory filename='pos' stride='{stride}'> positions </trajectory>
+    <trajectory filename='cen' stride='{stride}'> x_centroid </trajectory>
+    <trajectory filename='vel' stride='{stride}' bead='0'> velocities </trajectory>
+  </output>
+  <total_steps>{steps}</total_steps>
+  <prng><seed>{seed}</seed></prng>
+  <ffsocket name='drv' mode='unix' pbc='false'>
+    <address>{address}</address>
+  </ffsocket>
+  <system>
+    <initialize nbeads='{nbeads}'>
+      <cell mode='abc'> [200, 200, 200] </cell>
+      <file mode='xyz' units='atomic_unit'> init.xyz </file>
+      <velocities mode='thermal' units='kelvin'> {temp} </velocities>
+    </initialize>
+    <forces><force forcefield='drv'/></forces>
+    <motion mode='dynamics'>
+      <fixcom> False </fixcom>
+      <dynamics mode='{mode}'>
+        <timestep units='atomic_unit'> {dt} </timestep>
+        <thermostat mode='{thermo}'>
+          <tau units='atomic_unit'> {tau} </tau>
+          {extra_thermo}
+        </thermostat>
+        {classical}
+      </dynamics>
+    </motion>
+    <ensemble><temperature units='kelvin'> {temp} </temperature></ensemble>
+  </system>
+</simulation>
+"""
+
+
+def run_ipi(workdir, nbeads=8, steps=20000, dt=8.0, tau=400.0, thermo="pile_l",
+            classical="[0]", mode="nvt", stride=10, seed=12345, extra_thermo="",
+            timeout=1800):
+    workdir = Path(workdir)
+    workdir.mkdir(parents=True, exist_ok=True)
+    (workdir / "init.xyz").write_text(
+        "2\n# CELL(abcABC): 200 200 200 90 90 90 positions{atomic_unit} cell{atomic_unit}\n"
+        "C 0.5 0.0 0.0\nH 1.0 0.5 0.0\n"
+    )
+    address = "cl%d" % (os.getpid() % 100000)
+    cl = "<classical_atoms> %s </classical_atoms>" % classical if classical else ""
+    (workdir / "input.xml").write_text(
+        TEMPLATE.format(stride=stride, steps=steps, seed=seed, address=address, nbeads=nbeads,
+                        temp=TEMP, mode=mode, dt=dt, thermo=thermo, tau=tau, classical=cl,
+                        extra_thermo=extra_thermo)
+    )
+    env = dict(os.environ, PYTHONPATH=str(ROOT), PYTHONUNBUFFERED="1")
+    srv = subprocess.Popen([sys.executable, str(ROOT / "bin" / "i-pi"), "input.xml"], cwd=workdir,
+                           env=env, stdout=open(workdir / "ipi.log", "w"), stderr=subprocess.STDOUT)
+    time.sleep(3)
+    drv = subprocess.Popen(
+        [sys.executable, str(ROOT / "bin" / "i-pi-py_driver"), "-m", "coupled_harmonic", "-u",
+         "-a", address, "-o", "%g,%g" % (K_TRAP, K_SPR)],
+        cwd=workdir, env=env, stdout=open(workdir / "drv.log", "w"), stderr=subprocess.STDOUT)
+    try:
+        srv.wait(timeout=timeout)
+    finally:
+        drv.terminate()
+        if srv.poll() is None:
+            srv.kill()
+    log = (workdir / "ipi.log").read_text()
+    assert srv.returncode == 0, "i-PI failed:\n" + log[-3000:]
+    return workdir
+
+
+def read_xyz_frames(path, natoms):
+    lines = Path(path).read_text().splitlines()
+    n = natoms + 2
+    out = []
+    for i in range(0, len(lines) - n + 1, n):
+        out.append([[float(v) for v in lines[i + 2 + a].split()[1:4]] for a in range(natoms)])
+    return np.array(out)  # (frames, natoms, 3)
+
+
+def read_out(path):
+    cols, data = None, []
+    for line in Path(path).read_text().splitlines():
+        if line.startswith("#"):
+            if "column" in line:
+                cols = line
+            continue
+        data.append([float(v) for v in line.split()])
+    return np.array(data)
+
+
+def block_error(x, nblocks=20):
+    x = np.asarray(x, float)
+    n = len(x) // nblocks
+    b = x[: n * nblocks].reshape(nblocks, n).mean(axis=1)
+    return b.mean(), b.std(ddof=1) / np.sqrt(nblocks)
+
+
+def finite_p_bead_variance(P, m, k, temp=TEMP):
+    kT = KB * temp
+    wp = P * kT  # hbar = 1
+    w = 2 * wp * np.sin(np.pi * np.arange(P) / P)
+    return kT * np.sum(1.0 / (m * w**2 + k))
+
+
+@pytest.fixture(scope="module")
+def mixed_run(tmp_path_factory):
+    wd = tmp_path_factory.mktemp("mixed")
+    run_ipi(wd, nbeads=8, steps=int(os.environ.get("IPI_CA_STEPS", 60000)))
+    return wd
+
+
+def test_L_P3_coupled_harmonic(mixed_run):
+    P = 8
+    pos = np.array([read_xyz_frames(mixed_run / ("sim.pos_%d.xyz" % b), 2) for b in range(P)])
+    pos = pos[:, len(pos[0]) // 5:]  # drop first 20 %
+    # classical atom: all beads must coincide
+    assert np.max(np.abs(pos[:, :, 0, :] - pos[0:1, :, 0, :])) < 1e-9
+    X = pos[:, :, 0, :]  # (P, frames, 3)
+    x = pos[:, :, 1, :]
+    kT = KB * TEMP
+    X2 = (X[0] ** 2).sum(axis=1)  # per frame, 3 components
+    m, e = block_error(X2 / 3)
+    print("<X^2>/component = %.5g +- %.2g   exact %.5g" % (m, e, kT / K_TRAP))
+    assert abs(m - kT / K_TRAP) < max(3 * e, 0.03 * kT / K_TRAP)
+    d2 = ((x - X) ** 2).sum(axis=2).mean(axis=0)  # bead-averaged, per frame, 3 components
+    m, e = block_error(d2 / 3)
+    ref = finite_p_bead_variance(P, M, K_SPR)
+    print("<(x_j-X)^2>/component = %.5g +- %.2g   exact %.5g" % (m, e, ref))
+    assert abs(m - ref) < max(3 * e, 0.03 * ref)
+    xc = x.mean(axis=0)
+    c2 = ((xc - X[0]) ** 2).sum(axis=1)
+    m, e = block_error(c2 / 3)
+    print("<(x_c-X)^2>/component = %.5g +- %.2g   exact %.5g" % (m, e, kT / K_SPR))
+    assert abs(m - kT / K_SPR) < max(3 * e, 0.03 * kT / K_SPR)
+
+
+def test_L_P5_temperatures_and_conservation(mixed_run):
+    out = read_out(mixed_run / "sim.out")
+    # columns: step, conserved, temperature, potential, kinetic_cv
+    T = out[len(out) // 5:, 2]
+    m, e = block_error(T)
+    print("temperature = %.4g +- %.2g (target %.1f)" % (m, e, TEMP))
+    assert abs(m - TEMP) < max(3 * e, 0.03 * TEMP)
+
+
+def _conserved_drift(out):
+    c = out[:, 1]
+    kT = KB * TEMP
+    return (c.max() - c.min()) / kT, np.polyfit(np.arange(len(c)), c, 1)[0] * len(c) / kT
+
+
+def test_L_P4_nve_conservation(tmp_path):
+    """Constrained NVE dynamics must conserve the extended Hamiltonian."""
+    run_ipi(tmp_path, nbeads=8, steps=8000, dt=4.0, mode="nve", thermo="pile_l", stride=1)
+    out = read_out(tmp_path / "sim.out")
+    span, drift = _conserved_drift(out)
+    print("NVE conserved span / kT = %.3g, linear drift / kT = %.3g" % (span, drift))
+    assert span < 5e-2 and abs(drift) < 1e-2
+
+
+@pytest.mark.parametrize("thermo", ["pile_l", "pile_g"])
+def test_L_P4_nvt_conservation(tmp_path, thermo):
+    """With a thermostat the conserved quantity includes the heat ledger and the
+    energy removed from the classical atom's internal modes (booked in eens)."""
+    extra = "<pile_lambda> 0.5 </pile_lambda>" if thermo == "pile_g" else ""
+    run_ipi(tmp_path, nbeads=8, steps=8000, dt=4.0, mode="nvt", thermo=thermo, stride=1,
+            tau=200.0, extra_thermo=extra)
+    out = read_out(tmp_path / "sim.out")
+    span, drift = _conserved_drift(out)
+    print("NVT(%s) conserved span / kT = %.3g, linear drift / kT = %.3g" % (thermo, span, drift))
+    assert span < 5e-2 and abs(drift) < 1e-2
-- 
