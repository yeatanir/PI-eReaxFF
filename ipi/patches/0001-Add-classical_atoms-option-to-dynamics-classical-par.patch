     DummyIntegrator,
@@ -538,6 +634,8 @@ class NVTIntegrator(NVEIntegrator):
         """Velocity Verlet thermostat step"""
 
         self.thermostat.step()
+        # removes the noise that the thermostat has added to the classical atoms' internal modes
+        self.project_classical(book_energy=True)
 
     def step(self, step=None):
         """Does one simulation time step."""
