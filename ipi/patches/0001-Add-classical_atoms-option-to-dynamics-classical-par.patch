@@ -400,6 +464,38 @@ class DummyIntegrator:
             )
             self.nm.pnm[:, self.fixatoms_dof] = 0.0
 
+        # classical atoms: the momenta of the internal ring-polymer modes are removed.
+        # No energy is booked here: the momentum that is removed has just been added
+        # by a force kick that the constrained dynamics never applies. The thermostat
+        # noise that has to be removed is booked in `project_classical`.
+        if len(self.classical_dof) > 0:
+            self.nm.pnm[1:, self.classical_dof] = 0.0
+
+    def project_classical(self, book_energy=False):
+        """Holds the internal normal modes of the classical atoms at zero.
+
+        A classical atom is a ring polymer whose internal modes are removed:
+        q_k = p_k = 0 for k >= 1. In the i-PI convention (T_P = P*T, unscaled
+        bead potential) this is exactly a classical particle with the physical mass,
+        at temperature T, moving under the bead-averaged force, because the centroid
+        mode obeys  dP/dt = (1/P) sum_j f_j  once p~_0 = sqrt(P) P_phys is used.
+
+        Args:
+            book_energy: if True, the kinetic energy of the removed momenta is
+                added to ensemble.eens, which keeps the conserved quantity
+                correct when the removed energy came from a thermostat.
+        """
+
+        if len(self.classical_dof) == 0:
+            return
+        cd = self.classical_dof
+        self.nm.qnm[1:, cd] = 0.0
+        if book_energy:
+            pnm = dstrip(self.nm.pnm)
+            dynm3 = dstrip(self.nm.dynm3)
+            self.ensemble.eens += 0.5 * np.sum(pnm[1:, cd] ** 2 / dynm3[1:, cd])
+        self.nm.pnm[1:, cd] = 0.0
+
 
