Date: Wed, 11 Nov 2026 03:01:17 -0500
Subject: [PATCH 6/9] tests: propagator/transform variants with classical
 atoms; quartic coupling PES and transfer-matrix reference

exact, cayley and bab propagators with fft and matrix transforms conserve the extended energy and keep
classical beads identical. coupled_harmonic gains an optional quartic term g. The exact finite-P reference
(transfer matrix) reproduces the harmonic analytic result to 1e-4.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 ipi/pes/coupled_harmonic.py                   | 13 ++--
 .../classical_atoms/test_classical_atoms.py   | 77 +++++++++++++++++++
 2 files changed, 85 insertions(+), 5 deletions(-)

diff --git a/ipi/pes/coupled_harmonic.py b/ipi/pes/coupled_harmonic.py
index 68d7755..d146e61 100644
--- a/ipi/pes/coupled_harmonic.py
+++ b/ipi/pes/coupled_harmonic.py
@@ -3,7 +3,7 @@
 Test potential for simulations that mix a classical atom (atom 0) with a
 ring-polymer atom (atom 1):
 
-    V = 1/2 K |X|^2 + 1/2 k |x - X|^2
+    V = 1/2 K |X|^2 + sum_c [ 1/2 k d_c^2 + g d_c^4 ],   d = x - X
 
 Because V depends on x only through x - X, the ring-polymer part factorises
 from X, which gives exact references for a path-integral simulation at
@@ -29,11 +29,13 @@ class Coupled_harmonic_driver(Dummy_driver):
     Init parameters:
         :param K: float, trap constant acting on atom 0 (a.u.)
         :param k: float, spring constant between atoms 0 and 1 (a.u.)
+        :param g: float, optional quartic coupling per Cartesian component (a.u.), default 0
     """
 
-    def __init__(self, K, k, *args, **kwargs):
+    def __init__(self, K, k, g=0.0, *args, **kwargs):
         self.K = float(K)
         self.k = float(k)
+        self.g = float(g)
         super().__init__(*args, **kwargs)
 
     def compute_structure(self, cell, pos):
@@ -41,9 +43,10 @@ class Coupled_harmonic_driver(Dummy_driver):
         if p.shape[0] != 2:
             raise ValueError("coupled_harmonic needs exactly two atoms")
         d = p[1] - p[0]
-        pot = 0.5 * self.K * np.dot(p[0], p[0]) + 0.5 * self.k * np.dot(d, d)
+        pot = 0.5 * self.K * np.dot(p[0], p[0]) + 0.5 * self.k * np.dot(d, d) + self.g * np.sum(d**4)
+        fd = self.k * d + 4.0 * self.g * d**3  # force on atom 1 is -fd, on atom 0 is +fd
         force = np.zeros_like(p)
-        force[0] = -self.K * p[0] + self.k * d
-        force[1] = -self.k * d
+        force[0] = -self.K * p[0] + fd
+        force[1] = -fd
         vir = cell * 0.0
         return pot, force.reshape(pos.shape), vir, "nada"
diff --git a/ipi_tests/classical_atoms/test_classical_atoms.py b/ipi_tests/classical_atoms/test_classical_atoms.py
index 35d4ada..9e08d63 100644
--- a/ipi_tests/classical_atoms/test_classical_atoms.py
+++ b/ipi_tests/classical_atoms/test_classical_atoms.py
@@ -362,3 +362,80 @@ def test_mts_nvt_conservation(tmp_path, splitting):
     span, drift = _conserved_drift(read_out(tmp_path / "sim.out"))
     print("MTS [1,4] %s NVT conserved span / kT = %.3g, linear drift / kT = %.3g" % (splitting, span, drift))
     assert span < 5e-2 and abs(drift) < 1e-2
+
