+<simulation verbosity='low'>
+  <output prefix='simulation'>
+    <properties stride='1' filename='out'> [ step, conserved, temperature{kelvin}, potential, kinetic_md, kinetic_cv, spring ] </properties>
+    <trajectory filename='pos_c' stride='1'> x_centroid </trajectory>
+    <trajectory filename='frc_c' stride='1'> f_centroid </trajectory>
+    <trajectory filename='pos' stride='1' bead='0'> positions </trajectory>
+    <trajectory filename='vel' stride='1' bead='0'> velocities </trajectory>
+  </output>
+  <total_steps>20</total_steps>
+  <prng><seed>31415</seed></prng>
+  <ffsocket name='drv' mode='unix' pbc='false'>
+    <address>localhost</address>
+  </ffsocket>
+  <system>
+    <initialize nbeads='4'>
+      <cell mode='abc'> [200, 200, 200] </cell>
+      <file mode='xyz' units='atomic_unit'> init.xyz </file>
+      <velocities mode='thermal' units='kelvin'> 300 </velocities>
+    </initialize>
+    <forces><force forcefield='drv'/></forces>
+    <motion mode='dynamics'>
+      <fixcom> False </fixcom>
+      <dynamics mode='nvt' splitting='baoab'>
+        <timestep units='atomic_unit'> 8.0 </timestep>
+        <thermostat mode='pile_l'><tau units='atomic_unit'> 200 </tau></thermostat>
+        <classical_atoms> [0] </classical_atoms>
+      </dynamics>
+    </motion>
+    <ensemble><temperature units='kelvin'> 300 </temperature></ensemble>
+  </system>
+</simulation>
