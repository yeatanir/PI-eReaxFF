+def _mts_run(tmp_path, nmts, splitting="obabo", mode="nve", steps=4000, dt=8.0, **kw):
+    """Two force components: the trap on the classical atom (slow) and the classical-quantum spring (fast)."""
+    a1, a2 = "mts1_%d" % os.getpid(), "mts2_%d" % os.getpid()
+    ffs = ("<ffsocket name='slow' mode='unix' pbc='false'><address>%s</address></ffsocket>"
+           "<ffsocket name='fast' mode='unix' pbc='false'><address>%s</address></ffsocket>" % (a1, a2))
+    forces = ("<forces><force forcefield='slow'><mts_weights> [1, 0] </mts_weights></force>"
+              "<force forcefield='fast'><mts_weights> [0, 1] </mts_weights></force></forces>")
+    return run_ipi(tmp_path, nbeads=8, steps=steps, dt=dt, mode=mode, stride=1, splitting=splitting, ffs=ffs,
+                   forces=forces, dyn_extra="<nmts> %s </nmts>" % nmts, driver_opts="%g,0" % K_TRAP,
+                   address=a1, extra_drivers=[(a2, "coupled_harmonic", "0,%g" % K_SPR)], **kw)
+
+
+@pytest.mark.parametrize("splitting", ["obabo", "baoab"])
+def test_mts_nve_conservation(tmp_path, splitting):
+    """nmts = [1, 4]: slow trap force once per step, fast spring force four times."""
+    _mts_run(tmp_path, "[1, 4]", splitting=splitting)
+    span, drift = _conserved_drift(read_out(tmp_path / "sim.out"))
+    print("MTS [1,4] %s NVE conserved span / kT = %.3g, linear drift / kT = %.3g" % (splitting, span, drift))
+    assert span < 5e-2 and abs(drift) < 1e-2
