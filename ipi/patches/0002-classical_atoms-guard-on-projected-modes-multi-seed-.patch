+++ b/ipi/engine/motion/dynamics.py
@@ -215,7 +215,7 @@ class Dynamics(Motion):
         self.ensemble.add_xlkin(self.barostat._kin)
 
         # applies constraints immediately after initialization.
-        self.integrator.project_classical(book_energy=False)
+        self.integrator.project_classical(book_energy=False, check_positions=False)
         self.integrator.pconstraints()
 
         # TODO THOROUGH CLEAN-UP AND CHECK
@@ -471,7 +471,7 @@ class DummyIntegrator:
         if len(self.classical_dof) > 0:
             self.nm.pnm[1:, self.classical_dof] = 0.0
 
-    def project_classical(self, book_energy=False):
+    def project_classical(self, book_energy=False, check_positions=True):
         """Holds the internal normal modes of the classical atoms at zero.
 
         A classical atom is a ring polymer whose internal modes are removed:
@@ -484,11 +484,24 @@ class DummyIntegrator:
             book_energy: if True, the kinetic energy of the removed momenta is
                 added to ensemble.eens, which keeps the conserved quantity
                 correct when the removed energy came from a thermostat.
+            check_positions: if True, raise when the internal-mode positions are
+                not already zero. Nothing in the integrator moves them (zero
+                momentum, free propagation), so a non-zero value means that some
+                other code path has changed the beads and silently re-zeroing
+                would hide it.
         """
 
         if len(self.classical_dof) == 0:
             return
         cd = self.classical_dof
+        if check_positions:
+            qint = dstrip(self.nm.qnm)[1:, cd]
+            if qint.size > 0 and np.max(np.abs(qint)) > 1e-10:
+                raise ValueError(
+                    "classical_atoms: internal ring-polymer modes of a classical atom are "
+                    "non-zero (max %.3g); the beads of a classical atom have been displaced "
+                    "by something other than the integrator." % np.max(np.abs(qint))
+                )
         self.nm.qnm[1:, cd] = 0.0
         if book_energy:
             pnm = dstrip(self.nm.pnm)
