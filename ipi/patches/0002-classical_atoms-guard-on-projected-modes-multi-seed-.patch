+@pytest.mark.skipif(not UPSTREAM, reason="set IPI_UPSTREAM_ROOT to an unpatched i-PI checkout")
+def test_L_P1_patch_inactive_is_bitwise_identical(tmp_path):
+    """Without <classical_atoms> the patched code must reproduce unpatched i-PI exactly.
+    The coupled_harmonic driver is supplied by the patched tree to both runs."""
+    ref = tmp_path / "upstream"
+    new = tmp_path / "patched"
+    # the unpatched tree has no coupled_harmonic PES, so run its server against the patched driver
+    for wd, root in ((ref, UPSTREAM), (new, ROOT)):
+        run_ipi(wd, root=root, nbeads=8, steps=400, classical=None, mode="nvt", stride=1, seed=7,
+                driver_root=ROOT)
+    for name in ("sim.out", "sim.pos_0.xyz", "sim.pos_3.xyz", "sim.cen.xyz", "sim.vel_0.xyz"):
+        a, b = (ref / name).read_bytes(), (new / name).read_bytes()
+        assert a == b, "%s differs between unpatched and patched i-PI" % name
+
+
+def test_L_P2_all_atoms_classical_equals_P1(tmp_path):
+    """Exact equivalence: with every atom classical, P = 8 must reproduce an ordinary P = 1
+    NVE trajectory (same start), because the centroid mode obeys dP/dt = mean bead force.
+
+    i-PI rescales explicit initial velocities when it expands 1 bead to P beads, so the P = 1
+    run is started from the actual step-0 bead velocities of the P = 8 run."""
+    v0 = [2.0e-5, -1.0e-5, 5.0e-6, -1.5e-4, 8.0e-5, 3.0e-5]
+    kw = dict(steps=1500, dt=8.0, mode="nve", stride=1)
+    run_ipi(tmp_path / "p8", nbeads=8, classical="[0, 1]", velocities=v0, **kw)
+    v_start = read_xyz_frames(tmp_path / "p8" / "sim.vel_0.xyz", 2)[0].flatten()
+    run_ipi(tmp_path / "p1", nbeads=1, classical=None, velocities=list(v_start), **kw)
+    a = read_xyz_frames(tmp_path / "p1" / "sim.pos_0.xyz", 2)
+    b = read_xyz_frames(tmp_path / "p8" / "sim.pos_0.xyz", 2)
+    err = np.max(np.abs(a - b))
+    disp = np.max(np.abs(b - b[0]))
+    print("max |x(P=1) - x(P=8, classical)| = %.3g a.u. (largest displacement %.3g)" % (err, disp))
+    # positions are written with 6 decimals, so one unit in the last digit is the resolution
+    assert err < 2.5e-6
+    ea, eb = read_out(tmp_path / "p1" / "sim.out"), read_out(tmp_path / "p8" / "sim.out")
+    pot_err = np.max(np.abs(ea[:, 3] - eb[:, 3]))
+    print("max |V(P=1) - V(P=8, classical)| = %.3g Ha" % pot_err)
+    assert pot_err < 1e-6 * max(1e-3, np.max(np.abs(ea[:, 3])))
+    # all beads of a classical atom coincide
+    p3 = read_xyz_frames(tmp_path / "p8" / "sim.pos_3.xyz", 2)
+    assert np.max(np.abs(p3 - b)) < 1e-12
